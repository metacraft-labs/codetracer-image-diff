# Nim build artifacts
nimcache/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/
*.nim.cfg.bak
result
result-*

# Compiled tests
tests/test_*
!tests/test_*.nim
!tests/test_*.nim.cfg

# Test outputs (rendered FLIP error PNGs etc.)
tests/output/

# Editor / direnv
.direnv/
.envrc.local
*.swp

# Repro development environment cache
.repro/
