# Nim build artifacts
nimcache/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/
*.nim.cfg.bak
result
result-*

# Compiled tests
tests/test_*
!tests/test_*.nim
# Shell tests are sources too (the downstream lane's wiring test).
!tests/test_*.sh
!tests/test_*.nim.cfg

# repro build outputs (repro.nim TestSpec binaries in build/test-bin/,
# their per-test nimcache in build/nimcache/)
/build/

# Test outputs (rendered FLIP error PNGs etc.)
tests/output/

# Editor / direnv
.direnv/
.envrc.local
*.swp

# Repro development environment cache
.repro/
